# Copy to .env and fill in real values. Do not commit .env.
# Start locally with: set -a && source .env && set +a && ./mvnw spring-boot:run
# Start production with SPRING_PROFILES_ACTIVE=prod after the database schema already exists.

PORT=8080
CORS_ORIGINS=https://your-site.example

DATABASE_URL=jdbc:postgresql://localhost:5432/liveasyhomes
DATABASE_USERNAME=change-me
DATABASE_PASSWORD=change-me

JWT_SECRET=change-me-to-a-random-string-at-least-32-bytes
JWT_EXPIRATION_MINUTES=1440

ADMIN_EMAIL=admin@liveasyhomes.com
ADMIN_PASSWORD=change-me-at-least-12-characters

STORAGE_TYPE=r2
STORAGE_LOCAL_DIR=./uploads
STORAGE_PUBLIC_BASE_URL=http://localhost:8080

S3_BUCKET=
S3_REGION=ap-south-1
S3_ENDPOINT=
S3_ACCESS_KEY=
S3_SECRET_KEY=

R2_ACCOUNT_ID=
R2_BUCKET=properties-images
R2_ACCESS_KEY=
R2_SECRET_KEY=
R2_PUBLIC_BASE_URL=https://your-r2-public-host.example

OTP_EXPOSE=false
OTP_TTL_SECONDS=300

# Firebase phone auth for visit requests. Point this at a service account JSON file.
# That file stays on the server. Do not commit it.
FIREBASE_PROJECT_ID=
FIREBASE_CREDENTIALS_PATH=
RESEND_API_KEY=
RESEND_FROM=LivEasy Homes <request@liveasyhomes.in>
RESEND_CONTACT_FROM=LivEasy Homes <contact@liveasyhomes.in>
RESEND_RECIPIENTS=karan@liveasyhomes.in,dev.gdeepanshi@gmail.com
